NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only - never expose to the browser. Used by the dashboard and the
# Odoo sync job to read/write sales data (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Odoo external API (see README "Odoo connection")
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# Shared secret required as `Authorization: Bearer <value>` when calling
# /api/sync/odoo. Generate any random string. Vercel automatically sends
# this header on its own cron-triggered requests once the env var is set.
CRON_SECRET=

# Any random string. Required by the one-time /setup page to create the
# first admin account. Not needed after that (the page refuses to run
# again once an admin exists) but leave it set - no harm in that.
SETUP_SECRET=

# Google APIs (GA4, Search Console, and eventually Business Profile once
# its access request is approved) - one OAuth client shared across all
# three, a separate refresh token per API since each was authorized with
# its own scope. See README "Google APIs" for how these were obtained.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_GA4_REFRESH_TOKEN=
GOOGLE_GA4_PROPERTY_ID=
GOOGLE_GSC_REFRESH_TOKEN=
GOOGLE_GSC_SITE_URL=
GOOGLE_GBP_REFRESH_TOKEN=

# --- Membership (QR tent card -> wallet card) ---------------------------
# Public origin baked into the printed QR and wallet passes. Set to the live
# domain BEFORE printing tent cards, e.g. https://ops.asasi.com
MEMBERSHIP_BASE_URL=

# Google Wallet (optional - enables "Add to Google Wallet"). Issuer ID from
# the Google Wallet console; service account needs the Wallet Object Issuer
# role. Private key: paste the PEM with newlines as \n.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=

# Apple Wallet (optional - enables "Add to Apple Wallet"). Needs an Apple
# Developer account with a Pass Type ID. Each cert/key below is a PEM file,
# base64-encoded (e.g. `base64 -w0 pass-cert.pem`).
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=
